{
  "name": "wdg-tests-v17",
  "version": "17.0.0",
  "description": "Playwright e2e — devit.group (desktop only, no SEO, no timezone)",
  "scripts": {
    "test":             "npx playwright test",
    "test:chrome":      "npx playwright test --project=desktop-chrome",
    "test:firefox":     "npx playwright test --project=desktop-firefox",
    "test:headed":      "npx playwright test --headed --project=desktop-chrome --workers=1",
    "report":           "npx playwright show-report",
    "install:browsers": "npx playwright install chromium firefox"
  },
  "devDependencies": {
    "@playwright/test": "^1.44.0"
  }
}
